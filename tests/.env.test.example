# Configuración de QA. Copiar como tests/.env.test y ajustar a tu máquina.
# tests/.env.test NO se sube a Git.

# ---- Servidor PostgreSQL ----
PGHOST=localhost
PGPORT=5432

# Cuenta administrativa: crea la base de QA, aplica migraciones y seeds.
PG_ADMIN_USER=postgres
PG_ADMIN_PASSWORD=

# Base EXCLUSIVA de pruebas. Se borra y se recrea con "npm run preparar-bd".
# Por seguridad, el nombre debe terminar en _qa.
QA_DB_NAME=motor_adaptativo_qa

# Cuenta con la que se conecta el backend durante las pruebas.
# Recomendado: plataforma_backend.
# Si APP_DB_PASSWORD está vacío se usa la cuenta administrativa.
APP_DB_USER=plataforma_backend
APP_DB_PASSWORD=

# Secreto JWT solo para pruebas .
JWT_SECRET=qa-secreto-local-no-usar-en-produccion

# Cuenta demo que crea el seed de integración.
DEMO_EMAIL=estudiante.demo@example.com
DEMO_PASSWORD=DemoEquipo-2026!

# Ejecutable de Python con pandas instalado.
PYTHON=python

# Navegador para las pruebas E2E: "chrome" usa el Google Chrome instalado.
# Déjalo vacío para usar el Chromium de Playwright.
E2E_BROWSER_CHANNEL=chrome
